{
  "shellExec": "/bin/bash",
  "shellParams": "-c",
  "executeOnLoad": "openai.api_key = \"sk-\"\n",
  "notice": false,
  "decorateMultiline": false,
  "linesToSuppress": 1,
  "separatedShells": false,
  "prependOutput": ">>> ",
